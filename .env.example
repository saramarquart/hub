# paf_hub — environment. Copy to .env.local for local work.
#
# NOTHING SENSITIVE GOES IN THIS FILE OR ANY OTHER FILE IN THIS REPO. The real
# values live in Railway's environment variables. This repo is public today; a
# secret committed here is a secret published, and rotating it afterwards does
# not un-publish it.
#
# `npm run dev` needs NONE of this. With AUTH_MODE unset the dev bypass mints a
# local identity and the launcher renders; the bypass is disabled in production.

# --- Auth -------------------------------------------------------------------
# 'sso' turns on the real Google flow. Anything else is the dev bypass, which
# refuses to work when NODE_ENV=production.
AUTH_MODE=sso

# HMAC secret for the signed session cookie. 32+ random bytes, hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production refuses to mint sessions while this is unset — a known secret makes
# every cookie forgeable, and this repo is public.
AUTH_COOKIE_SECRET=

# Google OAuth client (Web application) for THIS app. Each Planet A app has its
# own client in the shared Google Cloud project; the redirect URI below must be
# registered on it, character for character, or Google refuses the round-trip.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hub.planet-a-foods.com/auth/google/callback

# Who may sign in. The hub is the company's launcher, so the rule is the domain.
ALLOWED_DOMAINS=forplaneta.com
# Individual guests on other domains (contractors). Usually empty.
ALLOWED_EMAILS=

# Who may administer tile visibility. Defaults to sara@forplaneta.com.
ADMIN_EMAILS=sara@forplaneta.com

# --- Deployment -------------------------------------------------------------
# Behind Railway's proxy a route handler's req.url resolves to the internal
# http://localhost:PORT. Redirect Locations are built from THIS instead, or the
# browser gets sent to localhost mid sign-in.
PUBLIC_BASE_URL=https://hub.planet-a-foods.com

# --- Staff directory (OPTIONAL — the admin console works without it) ------------
# /admin can offer a picker of real colleagues, read live from Google Workspace
# via the Admin SDK Directory API. It needs a service account with DOMAIN-WIDE
# DELEGATION for:
#     https://www.googleapis.com/auth/admin.directory.user.readonly
# granted by a Workspace super-admin under
#     Admin console -> Security -> API controls -> Domain-wide delegation
#
# UNSET IS THE EXPECTED STATE. With these blank the console says the directory is
# unavailable, explains why in one sentence, and takes a typed-in address — every
# other part of it works identically. Never commit an employee list instead.
#
# Same two variable names as the feedback app, so a value can be copied between
# Railway services without translation. Base64 because a PEM key has newlines in
# it and newlines in a Railway variable arrive mangled often enough to matter:
#   base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# The Workspace user the service account acts as. DWD cannot list users as
# "nobody" — this account must be allowed to read the directory.
GOOGLE_IMPERSONATE_EMAIL=

# --- Database ---------------------------------------------------------------
# Postgres. Holds the tile-visibility exception lists and nothing else.
# UNSET IS A SUPPORTED STATE: with no database there are no restrictions, so
# every tile is visible to everyone — exactly what the hub did before.
DATABASE_URL=
